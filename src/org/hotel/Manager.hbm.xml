<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="org.hotel">
    <class name="Manager" table="managertable">
        <id name="manid" column="manid"/>
        <property name="password" column="password"/>
        <property name="fullname" column="fullname"/>
        <property name="contact" column="contact"/>
        <property name="email" column="email"/>
        <property name="gender" column="gender"/>
        <property name="dob" column="dob"/>
        <property name="address" column="address"/>
        <property name="qualification" column="qualification"/>
    </class>
</hibernate-mapping>